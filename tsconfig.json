{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@component/*": ["./src/components/*"],
      "@hook/*": ["./src/hooks/*"],
      "@store/*": ["./src/stores/*"],
      "@provider/*": ["./src/providers/*"],
      "@i18n/*": ["./src/i18n/*"],
      "@util/*": ["./src/utils/*"],
      "@lib/*": ["./src/lib/*"],
      "@theme/*": ["./src/themes/*"],
      "@type/*": ["./src/types/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
